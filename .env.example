# Copy this file to ".env" (same folder) and edit. Lines starting with # are ignored.
# Defaults below work as-is with Ollama. You only need to change things if you want to.

# ---- Generator: answers questions, writes summaries, runs the agent ----
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# ---- Judge: only used by `eval.run_eval answers` to grade answers ----
# Keep it a DIFFERENT model family from LLM_MODEL (llama vs qwen) so it isn't grading its own style.
# 8 GB RAM machine -> qwen2.5:3b.  16 GB+ -> qwen2.5:7b (better judge).
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen2.5:3b

# ---- OPTIONAL: use a free hosted tier instead of Ollama (skip if you use Ollama) ----
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=paste-your-free-key-here
# LLM_MODEL=llama-3.1-8b-instant

# ---- Only needed if you expose the API to others ----
# ADMIN_API_KEY=choose-a-long-random-string
